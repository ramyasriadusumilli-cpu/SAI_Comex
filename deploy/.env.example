# Copy to /opt/saicomex/.env on the server, fill in real values, then:
#   chmod 600 /opt/saicomex/.env
#
# This file is the example. NEVER commit the real .env, and never paste a real
# value into any file in this repository — including the docs.

# --- public identity ---------------------------------------------------------
# No trailing slash. Used for CORS, the MinIO server URL and the reset link.
PUBLIC_URL=https://comex.saifleet.co.za

# --- database ----------------------------------------------------------------
DB_NAME=saicomex
DB_USER=comex_admin
DB_PASSWORD=

# --- auth --------------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
# Rotating this signs every active session out, which is the intended effect.
JWT_SECRET=

# --- object storage ----------------------------------------------------------
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=comex-files

# --- reporting ---------------------------------------------------------------
# The currency every stored base_amount is expressed in. Changing this after
# transactions exist does NOT retranslate history — see docs/STABILITY_RULES.md.
REPORTING_CURRENCY=USD
TZ=Africa/Johannesburg

# --- mail (optional) ---------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@saicomex.com
ADMIN_EMAIL=admin@saicomex.com

# --- diagnostics -------------------------------------------------------------
# Swagger publishes a map of every endpoint. Turn it on deliberately and
# temporarily, never as a standing setting.
SWAGGER_ENABLED=false
